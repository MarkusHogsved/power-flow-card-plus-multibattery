@@ -0,0 +1,138 @@
+import { getEntityState } from "@flixlix-cards/shared/states/utils/get-entity-state";
+import { getEntityStateWatts } from "@flixlix-cards/shared/states/utils/get-entity-state-watts";
+import {
+  type AdditionalBattery,
+  type CardMainContext,
+  type FlowCardPlusConfig,
+} from "@flixlix-cards/shared/types";
+import { displayValue } from "@flixlix-cards/shared/utils/display-value";
+import { type HomeAssistant } from "custom-card-helpers";
+import { html, nothing } from "lit";
+
+export interface AdditionalBatteryState {
+  config: AdditionalBattery;
+  name: string;
+  icon: string;
+  /** State of charge in %, null when unavailable. */
+  stateOfCharge: number | null;
+  /** Power in W, positive = charging. null when no power entity is configured or it is unavailable. */
+  power: number | null;
+}
+
+const friendlyName = (hass: HomeAssistant, entityId: string): string =>
+  (hass.states[entityId]?.attributes?.friendly_name as string | undefined) ?? entityId;
+
+export const computeAdditionalBatteries = (
+  hass: HomeAssistant,
+  batteries: AdditionalBattery[] | undefined
+): AdditionalBatteryState[] =>
+  (batteries ?? [])
+    .filter((b) => !!b?.state_of_charge)
+    .map((b) => {
+      const socAvailable = hass.states[b.state_of_charge] !== undefined;
+      const stateOfCharge = socAvailable ? getEntityState(hass, b.state_of_charge) : null;
+      let power: number | null = null;
+      if (
+        b.entity &&
+        hass.states[b.entity] !== undefined &&
+        getEntityState(hass, b.entity) !== null
+      ) {
+        const watts = getEntityStateWatts(hass, b.entity);
+        power = b.invert_state ? -watts : watts;
+      }
+      return {
+        config: b,
+        name: b.name ?? friendlyName(hass, b.state_of_charge),
+        icon: b.icon ?? "mdi:battery-outline",
+        stateOfCharge,
+        power,
+      };
+    });
+
+const formatPower = (
+  hass: HomeAssistant,
+  config: FlowCardPlusConfig,
+  power: number | null
+): string => {
+  if (power === null || power === 0) return "";
+  // Same arrows as the main battery circle: down = into the battery, up = out of it.
+  const arrow = power > 0 ? "↓" : "↑";
+  return ` ${arrow}${displayValue(hass, config, Math.abs(power), {})}`;
+};
+
+const formatSoc = (
+  hass: HomeAssistant,
+  config: FlowCardPlusConfig,
+  soc: number | null,
+  decimals?: number
+): string =>
+  soc === null
+    ? "–"
+    : displayValue(hass, config, soc, {
+        unit: "%",
+        unitWhiteSpace: false,
+        decimals: decimals ?? 0,
+      });
+
+/** Multi-line text for the native hover tooltip of the battery circle. */
+export const batteryTooltip = (
+  hass: HomeAssistant,
+  config: FlowCardPlusConfig,
+  main: {
+    name: string;
+    stateOfCharge: number | null;
+    stateOfChargeDecimals?: number;
+    toBattery: number | null;
+    fromBattery: number | null;
+  },
+  extras: AdditionalBatteryState[]
+): string => {
+  const mainPower = (main.toBattery ?? 0) - (main.fromBattery ?? 0);
+  const lines = [
+    `${main.name}: ${formatSoc(hass, config, main.stateOfCharge, main.stateOfChargeDecimals)}${formatPower(hass, config, mainPower)}`,
+    ...extras.map(
+      (e) =>
+        `${e.name}: ${formatSoc(hass, config, e.stateOfCharge, e.config.state_of_charge_decimals)}${formatPower(hass, config, e.power)}`
+    ),
+  ];
+  return lines.join("\n");
+};
+
+export const additionalBatteriesElement = (
+  main: CardMainContext,
+  config: FlowCardPlusConfig,
+  extras: AdditionalBatteryState[]
+) => {
+  if (!extras.length) return nothing;
+  return html`<div class="additional-batteries">
+    ${extras.map(
+      (e) =>
+        html`<span
+          class="additional-battery ${e.power !== null && e.power > 0
+            ? "charging"
+            : e.power !== null && e.power < 0
+              ? "discharging"
+              : ""}"
+          title="${e.name}: ${formatSoc(
+            main.hass,
+            config,
+            e.stateOfCharge,
+            e.config.state_of_charge_decimals
+          )}${formatPower(main.hass, config, e.power)}"
+          @click=${(ev: MouseEvent) => main.onEntityClick(ev, e.config, e.config.state_of_charge)}
+          @dblclick=${(ev: MouseEvent) =>
+            main.onEntityDoubleClick(ev, e.config, e.config.state_of_charge)}
+          @pointerdown=${(ev: PointerEvent) =>
+            main.onEntityPointerDown(ev, e.config, e.config.state_of_charge)}
+          @pointerup=${(ev: PointerEvent) => main.onEntityPointerUp(ev)}
+          @pointercancel=${(ev: PointerEvent) => main.onEntityPointerUp(ev)}
+          ><ha-icon class="small" .icon=${e.icon}></ha-icon>${formatSoc(
+            main.hass,
+            config,
+            e.stateOfCharge,
+            e.config.state_of_charge_decimals
+          )}</span
+        >`
+    )}
+  </div>`;
+};
