@@ -0,0 +1,161 @@
+import { describe, expect, test } from "vitest";
+
+import {
+  batteryTooltip,
+  computeAdditionalBatteries,
+} from "@flixlix-cards/shared/components/additional-batteries";
+import { type PowerFlowCardPlusConfig } from "@flixlix-cards/shared/types";
+import { render } from "lit";
+import { PowerFlowCardPlus } from "../src/power-flow-card-plus";
+
+(globalThis as any).ResizeObserver = class {
+  observe() {}
+  disconnect() {}
+  unobserve() {}
+};
+
+function makeHass(states: Record<string, [string, string?, string?]>) {
+  const hassStates: Record<string, any> = {};
+  for (const [id, [state, unit, name]] of Object.entries(states)) {
+    hassStates[id] = {
+      state,
+      attributes: { friendly_name: name ?? id, unit_of_measurement: unit },
+    };
+  }
+  return {
+    localize: (key: string) => key,
+    locale: { language: "en", number_format: "comma_decimal" },
+    states: hassStates,
+    config: {},
+    user: { name: "test" },
+    connection: {},
+  } as any;
+}
+
+const config = {
+  type: "custom:power-flow-card-plus",
+  kilo_threshold: 1000,
+  kilo_decimals: 1,
+  base_decimals: 0,
+} as any;
+
+describe("computeAdditionalBatteries", () => {
+  test("reads SOC and power, positive power = charging", () => {
+    const hass = makeHass({
+      "sensor.victron_soc": ["90", "%", "NKON"],
+      "sensor.victron_power": ["-259", "W"],
+    });
+    const [b] = computeAdditionalBatteries(hass, [
+      { state_of_charge: "sensor.victron_soc", entity: "sensor.victron_power", name: "Victron" },
+    ]);
+    expect(b.name).toBe("Victron");
+    expect(b.stateOfCharge).toBe(90);
+    expect(b.power).toBe(-259);
+  });
+
+  test("invert_state flips the sign and kW is converted to W", () => {
+    const hass = makeHass({ "sensor.soc": ["70", "%"], "sensor.p": ["1.2", "kW"] });
+    const [b] = computeAdditionalBatteries(hass, [
+      { state_of_charge: "sensor.soc", entity: "sensor.p", invert_state: true },
+    ]);
+    expect(b.power).toBe(-1200);
+  });
+
+  test("no power entity → power null, name falls back to friendly_name, default icon", () => {
+    const hass = makeHass({ "sensor.anker_soc": ["70", "%", "Anker UPS"] });
+    const [b] = computeAdditionalBatteries(hass, [{ state_of_charge: "sensor.anker_soc" }]);
+    expect(b.power).toBeNull();
+    expect(b.name).toBe("Anker UPS");
+    expect(b.icon).toBe("mdi:battery-outline");
+  });
+
+  test("missing or unavailable SOC entity → stateOfCharge null, entries without SOC are skipped", () => {
+    const hass = makeHass({ "sensor.soc": ["unavailable", "%"] });
+    const list = computeAdditionalBatteries(hass, [
+      { state_of_charge: "sensor.soc" },
+      { state_of_charge: "sensor.missing" },
+      { state_of_charge: "" } as any,
+    ]);
+    expect(list.length).toBe(2);
+    expect(list.map((b) => b.stateOfCharge)).toEqual([null, null]);
+  });
+});
+
+describe("batteryTooltip", () => {
+  test("one line per battery with SOC and direction", () => {
+    const hass = makeHass({
+      "sensor.v_soc": ["90", "%"],
+      "sensor.v_p": ["-259", "W"],
+      "sensor.a_soc": ["70", "%"],
+    });
+    const extras = computeAdditionalBatteries(hass, [
+      { state_of_charge: "sensor.v_soc", entity: "sensor.v_p", name: "Victron" },
+      { state_of_charge: "sensor.a_soc", name: "Anker" },
+    ]);
+    const text = batteryTooltip(
+      hass,
+      config,
+      { name: "Growatt", stateOfCharge: 88, toBattery: 0, fromBattery: 1300 },
+      extras
+    );
+    expect(text.split("\n")).toEqual(["Growatt: 88% ↑1.3 kW", "Victron: 90% ↑259 W", "Anker: 70%"]);
+  });
+});
+
+describe("card render", () => {
+  const cardConfig = {
+    type: "custom:power-flow-card-plus",
+    entities: {
+      grid: { entity: "sensor.grid" },
+      battery: {
+        entity: "sensor.battery",
+        state_of_charge: "sensor.battery_soc",
+        additional_batteries: [
+          {
+            state_of_charge: "sensor.v_soc",
+            entity: "sensor.v_p",
+            name: "Victron",
+            icon: "mdi:home-battery",
+          },
+          { state_of_charge: "sensor.a_soc", name: "Anker" },
+        ],
+      },
+    },
+  } as unknown as PowerFlowCardPlusConfig;
+
+  const renderCard = (cfg: PowerFlowCardPlusConfig) => {
+    const hass = makeHass({
+      "sensor.grid": ["100", "W"],
+      "sensor.battery": ["0", "W"],
+      "sensor.battery_soc": ["88", "%"],
+      "sensor.v_soc": ["90", "%"],
+      "sensor.v_p": ["500", "W"],
+      "sensor.a_soc": ["70", "%"],
+    });
+    const card = new PowerFlowCardPlus();
+    card.setConfig(cfg);
+    card.hass = hass;
+    card.connectedCallback();
+    const container = document.createElement("div");
+    render((card as unknown as { render: () => any }).render(), container);
+    return container;
+  };
+
+  test("renders one chip per additional battery and a tooltip on the battery circle", () => {
+    const el = renderCard(cardConfig);
+    const chips = el.querySelectorAll(".additional-battery");
+    expect(chips.length).toBe(2);
+    expect(chips[0].textContent?.trim()).toBe("90%");
+    expect(chips[0].classList.contains("charging")).toBe(true);
+    const container = el.querySelector(".circle-container.battery");
+    expect(container?.getAttribute("title")).toContain("Victron: 90% ↓500 W");
+  });
+
+  test("without additional_batteries nothing changes (no chips, no tooltip)", () => {
+    const cfg = JSON.parse(JSON.stringify(cardConfig));
+    delete cfg.entities.battery.additional_batteries;
+    const el = renderCard(cfg);
+    expect(el.querySelectorAll(".additional-battery").length).toBe(0);
+    expect(el.querySelector(".circle-container.battery")?.hasAttribute("title")).toBe(false);
+  });
+});
